MONGO_URI=mongodb://localhost:27017/InventoryManagementDB
JWT_SECRET=change-this-secret-in-production
PORT=4000

# Optional
# CLIENT_ORIGIN=http://localhost:5173
# ALLOW_ADMIN_SIGNUP=true   (demo only: lets the sign-up form create admins)
# CLIENT_URL=http://localhost:5173        (base URL used in password-reset links; default shown)
# RESET_LINK_IN_RESPONSE=true             (demo only: also return the reset link in the API response.
#                                          There is no mail server, so by default the link is printed in the server console)
